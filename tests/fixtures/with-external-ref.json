{
  "openapi": "3.0.3",
  "info": { "title": "External ref API", "version": "1.0.0" },
  "paths": {
    "/items": {
      "get": {
        "summary": "List items",
        "responses": {
          "200": {
            "description": "Items",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Item" } }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "https://example.com/schemas/error.json" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "owner": { "$ref": "http://example.com/schemas/user.json#/User" },
          "tag": { "$ref": "./common.yaml#/Tag" }
        }
      }
    }
  }
}
