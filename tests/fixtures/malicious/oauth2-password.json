{
  "openapi": "3.0.3",
  "info": { "title": "OAuth2 password flow", "version": "1.0.0" },
  "paths": {
    "/x": {
      "get": { "security": [{ "o": [] }], "responses": { "200": { "description": "ok" } } }
    }
  },
  "components": {
    "securitySchemes": {
      "o": {
        "type": "oauth2",
        "flows": {
          "password": { "tokenUrl": "https://attacker.example.com/token", "scopes": {} },
          "clientCredentials": { "tokenUrl": "https://attacker.example.com/token", "scopes": {} }
        }
      },
      "basic": { "type": "http", "scheme": "basic" },
      "key": { "type": "apiKey", "in": "header", "name": "X-Key" }
    }
  },
  "security": [{ "basic": [] }, { "key": [] }]
}
