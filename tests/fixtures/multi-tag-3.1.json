{
  "openapi": "3.1.0",
  "info": {
    "title": "Bookshop API",
    "version": "2.1.0",
    "description": "Fixture with several tags, shared components and OpenAPI 3.1 features.",
    "license": { "name": "MIT", "identifier": "MIT" }
  },
  "tags": [
    { "name": "books", "description": "Catalogue" },
    { "name": "orders", "description": "Ordering" },
    { "name": "users", "description": "Accounts" }
  ],
  "paths": {
    "/books": {
      "get": {
        "tags": ["books"],
        "summary": "List books",
        "operationId": "listBooks",
        "parameters": [{ "$ref": "#/components/parameters/Limit" }],
        "responses": {
          "200": {
            "description": "A page of books",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Book" } }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["books"],
        "summary": "Add a book",
        "operationId": "addBook",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Book" } } }
        },
        "responses": {
          "201": { "description": "Created" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/books/{bookId}": {
      "get": {
        "tags": ["books"],
        "summary": "Get a book",
        "operationId": "getBook",
        "parameters": [
          { "name": "bookId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The book",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Book" } } }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/orders": {
      "post": {
        "tags": ["orders"],
        "summary": "Place an order",
        "operationId": "placeOrder",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } }
        },
        "responses": {
          "201": {
            "description": "Order placed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Order" } }
            }
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "tags": ["users"],
        "summary": "Current user",
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "The user",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          }
        }
      }
    }
  },
  "webhooks": {
    "orderShipped": {
      "post": {
        "summary": "Sent when an order ships",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } }
        },
        "responses": { "200": { "description": "Acknowledged" } }
      }
    }
  },
  "components": {
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "Book": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "subtitle": { "type": ["string", "null"] },
          "author": { "$ref": "#/components/schemas/User" }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Book" } },
          "status": { "enum": ["new", "shipped", "cancelled"] }
        }
      },
      "User": {
        "type": "object",
        "properties": { "id": { "type": "string" }, "name": { "type": "string" } }
      },
      "Error": {
        "type": "object",
        "properties": { "code": { "type": "integer" }, "message": { "type": "string" } }
      }
    }
  }
}
