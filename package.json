{
  "name": "koapidoc",
  "version": "0.1.0",
  "private": true,
  "description": "Confluence macro that renders OpenAPI / Swagger specifications.",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "npm run build --prefix static/macro-ui",
    "typecheck": "tsc --noEmit && npm run typecheck --prefix static/macro-ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "forge:lint": "forge lint",
    "dev:local": "npm run dev:local --prefix static/macro-ui",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "fixtures:large": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/fixtures/write-large-spec.mts",
    "format:check": "prettier --check .",
    "licenses": "npx --yes license-checker@25 --production --summary --start static/macro-ui"
  },
  "dependencies": {
    "@forge/resolver": "^2.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@forge/cli": "^14.1.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
